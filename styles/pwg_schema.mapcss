/*
 * Generated from schema/1.0.1.mw and schema/1.0.1.json by scripts/generate-josm-mapcss.js.
 * Colors show the highest automatically satisfied PWG tier; red needs review.
 * Conditional requirements with real-world conditions remain manual review.
 */

meta {
  title: "PWG Schema v1.0.1 Tiers";
  version: "1.0.1";
  description: "Colors PWG features by their highest automatically satisfied schema tier.";
  link: "https://github.com/lumikeiju/osm-us-pwg";
}

/* Sidewalk: below Bronze tier */
way["footway"="sidewalk"]["highway"="footway"]
{
  color: #ff1744;
  width: 4;
  opacity: 0.9;
  casing-color: #202020;
  casing-width: 1;
}

/* Sidewalk: Bronze tier */
way["footway"="sidewalk"]["highway"="footway"]
{
  color: #e58139;
  width: 4;
  opacity: 0.9;
  casing-color: #202020;
  casing-width: 1;
}

/* Sidewalk: Silver tier */
way["footway"="sidewalk"]["highway"="footway"]["surface"=~/^.*\S.*$/]
{
  color: #cccccc;
  width: 4;
  opacity: 0.9;
  casing-color: #202020;
  casing-width: 1;
}

/* Sidewalk: Gold tier */
way["footway"="sidewalk"]["highway"="footway"]["lit"=~/^.*\S.*$/]["surface"=~/^.*\S.*$/]["width"=~/^\s*-?\d+(?:\.\d+)?(?:\s*(?:[mM][mM]|[cC][mM]|[kK][mM]|[iI][nN]|[fF][tT]|[yY][dD]|[mM][iI]|[mM]))?\s*$/]
{
  color: #e5c839;
  width: 4;
  opacity: 0.9;
  casing-color: #202020;
  casing-width: 1;
}

/* Sidewalk: Diamond tier */
way["footway"="sidewalk"]["highway"="footway"]["incline:across"=~/^\s*(?:up|down|[+-]?\d+(?:\.\d+)?(?:%|°))\s*$/]["lit"=~/^.*\S.*$/]["surface"=~/^.*\S.*$/]["tactile_paving"!~/^(?:yes)$/]["tactile_paving"=~/^(?:yes|no)$/]["width"=~/^\s*-?\d+(?:\.\d+)?(?:\s*(?:[mM][mM]|[cC][mM]|[kK][mM]|[iI][nN]|[fF][tT]|[yY][dD]|[mM][iI]|[mM]))?\s*$/],
way["footway"="sidewalk"]["highway"="footway"]["incline:across"=~/^\s*(?:up|down|[+-]?\d+(?:\.\d+)?(?:%|°))\s*$/]["lit"=~/^.*\S.*$/]["surface"=~/^.*\S.*$/]["tactile_paving:colour"=~/^.*\S.*$/]["tactile_paving"=~/^(?:yes)$/]["tactile_paving"=~/^(?:yes|no)$/]["width"=~/^\s*-?\d+(?:\.\d+)?(?:\s*(?:[mM][mM]|[cC][mM]|[kK][mM]|[iI][nN]|[fF][tT]|[yY][dD]|[mM][iI]|[mM]))?\s*$/]
{
  color: #39c8e5;
  width: 4;
  opacity: 0.9;
  casing-color: #202020;
  casing-width: 1;
}

