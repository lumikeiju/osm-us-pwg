  casing-width: 1;
  dashes: list(3, 6);
}

/* Footway Area: below Gold tier */
way:closed["area:highway"="footway"],
relation["area:highway"="footway"]
{
  fill-color: #ff1744;
  fill-opacity: 0.35;
  color: #ff1744;
  width: 2;
}

/* Footway Area: Gold tier */
way:closed["area:highway"="footway"],
relation["area:highway"="footway"]
{
  fill-color: #e5c839;
  fill-opacity: 0.35;
  color: #e5c839;
  width: 2;
}

/* Footway Area: Diamond tier */
way:closed["area:highway"="footway"],
relation["area:highway"="footway"]
{
  fill-color: #39c8e5;
  fill-opacity: 0.35;
  color: #39c8e5;
  width: 2;
}

/* Roadway: below Bronze tier */
way[!"footway"]["highway"]
{
  color: #ff1744;
  width: 2;
  opacity: 0.9;
  casing-color: #202020;
  casing-width: 1;
  dashes: list(8, 5);
}

/* Roadway: Bronze tier */
way[!"footway"]["highway"]["sidewalk:both"=~/^(?:no|separate)$/],
way[!"footway"]["highway"]["sidewalk:left"=~/^(?:no|separate)$/]["sidewalk:right"=~/^(?:no|separate)$/]
{
  color: #e58139;
  width: 2;
  opacity: 0.9;
  casing-color: #202020;
  casing-width: 1;
  dashes: list(8, 5);
}

/* Roadway: Silver tier */
way[!"footway"]["highway"]["sidewalk:both"=~/^(?:no|separate)$/],
way[!"footway"]["highway"]["sidewalk:left"=~/^(?:no|separate)$/]["sidewalk:right"=~/^(?:no|separate)$/]
{
  color: #cccccc;
  width: 2;
  opacity: 0.9;
  casing-color: #202020;
  casing-width: 1;
  dashes: list(8, 5);
}

/* Roadway: Gold tier */
way[!"footway"]["highway"]["maxspeed"=~/^.*\S.*$/]["sidewalk:both"=~/^(?:no|separate)$/],
way[!"footway"]["highway"]["maxspeed"=~/^.*\S.*$/]["sidewalk:left"=~/^(?:no|separate)$/]["sidewalk:right"=~/^(?:no|separate)$/]
{
  color: #e5c839;
  width: 2;
  opacity: 0.9;
  casing-color: #202020;
  casing-width: 1;
  dashes: list(8, 5);
}

/* Roadway: Diamond tier */
way[!"footway"]["highway"]["maxspeed"=~/^.*\S.*$/]["sidewalk:both"=~/^(?:no|separate)$/],
way[!"footway"]["highway"]["maxspeed"=~/^.*\S.*$/]["sidewalk:left"=~/^(?:no|separate)$/]["sidewalk:right"=~/^(?:no|separate)$/]
{
  color: #39c8e5;
  width: 2;
  opacity: 0.9;
  casing-color: #202020;
  casing-width: 1;
  dashes: list(8, 5);
}
