    - id: tier-traffic_sign-glow-diamond
      type: circle
      filter: ["all",["all",["==",["geometry-type"],"Point"],["has","traffic_sign"]],["all",["has","traffic_sign"],["in",",38,",["to-string",["get","@pwg:valid"]]]]]
      paint:
        circle-color: "#39c8e5"
        circle-radius:
          stops: [[13,8],[17,14]]
        circle-opacity: 0.45
        circle-blur: 0.55
        circle-stroke-width: 0
    - id: tier-traffic_sign-shine
      type: circle
      filter: ["all",["all",["==",["geometry-type"],"Point"],["has","traffic_sign"]],["all",["has","traffic_sign"],["in",",37,",["to-string",["get","@pwg:valid"]]]]]
      paint:
        circle-color: "#ffffff"
        circle-radius:
          stops: [[13,4.1],[17,10.1]]
        circle-opacity: 0.85
        circle-translate: [-1.1,-1.1]
        circle-stroke-width: 0
    - id: tier-traffic_sign
      type: circle
      filter: ["all",["==",["geometry-type"],"Point"],["has","traffic_sign"]]
      paint:
        circle-color: ["case",["all",["has","traffic_sign"],["in",",38,",["to-string",["get","@pwg:valid"]]]],"#39c8e5",["all",["has","traffic_sign"],["in",",37,",["to-string",["get","@pwg:valid"]]]],"#e5c839","#ff1744"]
        circle-radius:
          stops: [[13,3],[17,9]]
        circle-stroke-color: "#202020"
        circle-stroke-width: 1.4
        circle-opacity: 0.95
---
SELECT osm_type, osm_id, tags, geom
FROM postpass_pointlinepolygon
WHERE geom && ST_MakeEnvelope({{wsen}}, 4326)
  AND (
    (osm_type = 'W' AND tags->>'highway' = 'footway' AND tags->>'footway' = 'sidewalk')
    OR (osm_type = 'W' AND tags->>'highway' = 'footway' AND tags->>'footway' = 'crossing')
    OR (osm_type = 'N' AND tags->>'highway' = 'crossing' AND NOT (tags ? 'footway'))
    OR (osm_type = 'N' AND tags->>'barrier' = 'kerb')
    OR (osm_type = 'W' AND tags->>'highway' = 'footway' AND tags->>'footway' = 'traffic_island')
    OR (osm_type = 'W' AND tags->>'highway' = 'footway' AND tags->>'footway' = 'access_aisle')
    OR (osm_type = 'W' AND tags->>'highway' = 'steps')
    OR (osm_type = 'W' AND tags->>'area:highway' = 'footway')
    OR (osm_type = 'R' AND tags->>'area:highway' = 'footway')
    OR (osm_type = 'W' AND tags ? 'highway' AND NOT (tags ? 'footway') AND tags->>'highway' IS DISTINCT FROM 'steps')
    OR (osm_type = 'N' AND tags ? 'traffic_sign')
  )
