title: PWG Schema Tier View
description: Schema-generated PWG tier visualization. Colors indicate the highest automatically satisfied PWG tier. Red features match a feature identifier but do not yet satisfy its minimum-tier requirements and need review.
type: postpass
popupTemplate: |
  {% assign id = osm_id %}
  {% assign typeLabel = osm_type %}
  {% case osm_type %}
    {% when "N" %}{% assign type = "node" %}
    {% when "W" %}{% assign type = "way" %}
    {% when "R" %}{% assign type = "relation" %}
    {% else %}{% assign type = osm_type %}
  {% endcase %}
  {% if type and id %}
    <h2>{{ typeLabel | escape }} <a href="https://www.openstreetmap.org/{{ type | escape }}/{{ id | escape }}" target="_blank">{{ id | escape }}</a> <a href="https://www.openstreetmap.org/edit?{{ type | escape }}={{ id | escape }}" target="_blank">Edit</a></h2>
  {% endif %}
  {% for tag in properties %}
    {% if tag[0] == "@pwg:valid" %}{% continue %}{% endif %}
    <code>{{ tag[0] | escape }} = {{ tag[1] | json | escape }}</code><br>
  {% endfor %}
# Validate OSM tag values once per rule using the shared PWG evaluator.
transform: |
  function valueMatchesSpec(value, spec) {
    if (value === undefined) {
      return false;
    }

    const stringValue = String(value).trim();
    if (spec?.notValues?.map(String).includes(stringValue)) {
      return false;
    }

    if (!spec) {
      return stringValue.length > 0;
    }

    switch (spec.type) {
      case "enum":
        return (spec.values ?? []).map(String).includes(stringValue);
      case "openEnum":
      case "free":
        return stringValue.length > 0;
      case "boolean":
        return ["yes", "no"].includes(stringValue);
      case "numeric":
        return stringValue !== "" && Number.isFinite(Number(stringValue));
      case "length":
        return /^-?\d+(?:\.\d+)?(?:\s*(?:mm|cm|m|km|in|ft|yd|mi))?$/i.test(
          stringValue
        );
      case "percent":
        return /^-?\d+(?:\.\d+)?%$/.test(stringValue);
      case "incline":
        return /^(?:up|down|[+-]?\d+(?:\.\d+)?(?:%|\u00b0))$/.test(stringValue);
      default:
        return stringValue.length > 0;
    }
  }
  function validateFeatureValues(data, checks, provider, matchesValue, property) {
    for (const feature of data.features) {
      let tags = feature.properties ?? {};
      let properties = { ...tags };
      if (provider === "postpass") {
        const { tags: nestedTags, ...metadata } = properties;
        tags = nestedTags ?? {};
        properties = { ...tags, ...metadata };
      }

      // Keep the derived values in one scalar property for MapLibre's GeoJSON tiles.
      const passed = [];
      for (const [index, [key, spec]] of checks.entries()) {
        if (Object.hasOwn(tags, key) && matchesValue(String(tags[key]), spec)) {
          passed.push(index);
        }
      }
      properties[property] = `,${passed.join(",")},`;
      feature.properties = properties;
    }
    return data;
  }
  const checks = [["surface",{"type":"openEnum","values":["concrete","asphalt"]}],["lit",{"type":"openEnum","values":["yes","no"]}],["width",{"type":"length"}],["incline:across",{"type":"incline"}],["tactile_paving",{"type":"enum","values":["yes","no"]}],["tactile_paving:colour",{"type":"free"}],["crossing:markings",{"type":"openEnum","values":["zebra","lines","no"],"notValues":["yes"]}],["crossing:signals",{"type":"enum","values":["yes","no"]}],["crossing:island",{"type":"enum","values":["separate","no"]}],["crossing:signed",{"type":"enum","values":["yes","no"]}],["button_operated",{"type":"enum","values":["yes","no"]}],["flashing_lights",{"type":"enum","values":["yes","no"]}],["traffic_signals:arrow",{"type":"enum","values":["yes","no"]}],["traffic_signals:vibration",{"type":"enum","values":["yes","no"]}],["traffic_signals:sound",{"type":"enum","values":["yes","no"]}],["crossing:signals",{"type":"enum","values":["no","shared","dedicated"]}],["flashing_lights",{"type":"openEnum","values":["no","always","button","sensor","button;sensor"],"notValues":["yes"]}],["traffic_signals:sound",{"type":"enum","values":["yes","no","locate","walk","locate;walk","walk;locate"]}],["traffic_signals:minimap",{"type":"enum","values":["yes","no"]}],["crossing:flags",{"type":"enum","values":["yes","no"]}],["crossing:markings",{"type":"enum","values":["yes","no"]}],["tactile_paving",{"type":"enum","values":["yes","no","partial"]}],["kerb",{"type":"enum","values":["raised","lowered","flush","rolled","no"]}],["kerb:height",{"type":"length"}],["access_aisle:markings",{"type":"openEnum","values":["no","yes","zebra","ladder:skewed"]}],["incline",{"type":"enum","values":["up","down"]}],["step_count",{"type":"numeric"}],["ramp",{"type":"enum","values":["no","separate"]}],["handrail",{"type":"openEnum","values":["yes","no"]}],["handrail:both",{"type":"enum","values":["yes","no"]}],["handrail:left",{"type":"enum","values":["yes","no"]}],["handrail:right",{"type":"enum","values":["yes","no"]}],["ramp",{"type":"enum","values":["yes","no"]}],["sidewalk:both",{"type":"enum","values":["no","separate"]}],["sidewalk:left",{"type":"enum","values":["no","separate"]}],["sidewalk:right",{"type":"enum","values":["no","separate"]}],["maxspeed",{"type":"free"}],["traffic_sign",{"type":"openEnum","values":["stop","give_way"]}],["traffic_sign",{"type":"openEnum","values":["US:R1-1","US:S1-1","US:W11-2","US:W11-15","US:W16-2P","US:W16-7P","US:W16-9P"],"notValues":["stop","give_way"]}]];
  export default function (data) {
    return validateFeatureValues(data, checks, "postpass", valueMatchesSpec, "@pwg:valid");
  }
style:
  extends: https://styles.trailsta.sh/protomaps-black.json
  layers:
