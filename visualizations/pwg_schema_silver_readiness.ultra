---
title: PWG Schema Silver Readiness View
description: Schema-generated Silver readiness visualization. #cccccc gray/silver features satisfy Silver tier requirements for accessibility-focused applications; #ff1744 red features match a PWG feature identifier but are not yet Silver-ready. Features introduced above Silver are omitted.
style:
  extends: https://styles.trailsta.sh/protomaps-black.json
  layers:
    - id: readiness-sidewalk
      type: line
      filter: ["all",["==",["geometry-type"],"LineString"],["all",["==",["get","highway"],"footway"],["==",["get","footway"],"sidewalk"]]]
      paint:
        line-color: ["case",["all",["all",["==",["get","highway"],"footway"],["==",["get","footway"],"sidewalk"]],[">",["length",["to-string",["get","surface"]]],0]],"#cccccc","#ff1744"]
        line-width: ["interpolate",["linear"],["zoom"],13,["case",["all",["all",["==",["get","highway"],"footway"],["==",["get","footway"],"sidewalk"]],[">",["length",["to-string",["get","surface"]]],0]],1,2],17,["case",["all",["all",["==",["get","highway"],"footway"],["==",["get","footway"],"sidewalk"]],[">",["length",["to-string",["get","surface"]]],0]],3,6]]
        line-opacity: ["case",["all",["all",["==",["get","highway"],"footway"],["==",["get","footway"],"sidewalk"]],[">",["length",["to-string",["get","surface"]]],0]],0.55,0.9]
    - id: readiness-crossing_way
      type: line
      filter: ["all",["==",["geometry-type"],"LineString"],["all",["==",["get","highway"],"footway"],["==",["get","footway"],"crossing"]]]
      paint:
        line-color: ["case",["all",["all",["==",["get","highway"],"footway"],["==",["get","footway"],"crossing"]],["all",[">",["length",["to-string",["get","crossing:markings"]]],0],["!=",["to-string",["get","crossing:markings"]],"yes"]],["any",["==",["get","crossing:signals"],"yes"],["==",["get","crossing:signals"],"no"]],[">",["length",["to-string",["get","surface"]]],0],["any",["==",["get","crossing:island"],"yes"],["==",["get","crossing:island"],"no"]]],"#cccccc","#ff1744"]
        line-width: ["interpolate",["linear"],["zoom"],13,["case",["all",["all",["==",["get","highway"],"footway"],["==",["get","footway"],"crossing"]],["all",[">",["length",["to-string",["get","crossing:markings"]]],0],["!=",["to-string",["get","crossing:markings"]],"yes"]],["any",["==",["get","crossing:signals"],"yes"],["==",["get","crossing:signals"],"no"]],[">",["length",["to-string",["get","surface"]]],0],["any",["==",["get","crossing:island"],"yes"],["==",["get","crossing:island"],"no"]]],1,2],17,["case",["all",["all",["==",["get","highway"],"footway"],["==",["get","footway"],"crossing"]],["all",[">",["length",["to-string",["get","crossing:markings"]]],0],["!=",["to-string",["get","crossing:markings"]],"yes"]],["any",["==",["get","crossing:signals"],"yes"],["==",["get","crossing:signals"],"no"]],[">",["length",["to-string",["get","surface"]]],0],["any",["==",["get","crossing:island"],"yes"],["==",["get","crossing:island"],"no"]]],3,6]]
        line-opacity: ["case",["all",["all",["==",["get","highway"],"footway"],["==",["get","footway"],"crossing"]],["all",[">",["length",["to-string",["get","crossing:markings"]]],0],["!=",["to-string",["get","crossing:markings"]],"yes"]],["any",["==",["get","crossing:signals"],"yes"],["==",["get","crossing:signals"],"no"]],[">",["length",["to-string",["get","surface"]]],0],["any",["==",["get","crossing:island"],"yes"],["==",["get","crossing:island"],"no"]]],0.55,0.9]
        line-dasharray: [1.2,1.2]
    - id: readiness-crossing_node
      type: circle
      filter: ["all",["==",["geometry-type"],"Point"],["all",["==",["get","highway"],"crossing"],["!",["has","footway"]]]]
