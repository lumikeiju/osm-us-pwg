      type: line
      filter: ["all",["==",["geometry-type"],"LineString"],["all",["has","highway"],["!",["has","footway"]]]]
      paint:
        line-color: ["case",["all",["all",["has","highway"],["!",["has","footway"]]],["any",["any",["==",["get","sidewalk:both"],"no"],["==",["get","sidewalk:both"],"separate"]],["all",["any",["==",["get","sidewalk:left"],"no"],["==",["get","sidewalk:left"],"separate"]],["any",["==",["get","sidewalk:right"],"no"],["==",["get","sidewalk:right"],"separate"]]]]],"#cccccc","#ff1744"]
        line-width: ["interpolate",["linear"],["zoom"],13,["case",["all",["all",["has","highway"],["!",["has","footway"]]],["any",["any",["==",["get","sidewalk:both"],"no"],["==",["get","sidewalk:both"],"separate"]],["all",["any",["==",["get","sidewalk:left"],"no"],["==",["get","sidewalk:left"],"separate"]],["any",["==",["get","sidewalk:right"],"no"],["==",["get","sidewalk:right"],"separate"]]]]],0.4,0.8],17,["case",["all",["all",["has","highway"],["!",["has","footway"]]],["any",["any",["==",["get","sidewalk:both"],"no"],["==",["get","sidewalk:both"],"separate"]],["all",["any",["==",["get","sidewalk:left"],"no"],["==",["get","sidewalk:left"],"separate"]],["any",["==",["get","sidewalk:right"],"no"],["==",["get","sidewalk:right"],"separate"]]]]],1,2]]
        line-opacity: ["case",["all",["all",["has","highway"],["!",["has","footway"]]],["any",["any",["==",["get","sidewalk:both"],"no"],["==",["get","sidewalk:both"],"separate"]],["all",["any",["==",["get","sidewalk:left"],"no"],["==",["get","sidewalk:left"],"separate"]],["any",["==",["get","sidewalk:right"],"no"],["==",["get","sidewalk:right"],"separate"]]]]],0.55,0.9]
        line-dasharray: [3,2]
---
[bbox:{{bbox}}];
(
  way[highway=footway][footway~"^(sidewalk|crossing|traffic_island|access_aisle)$"];
  way["area:highway"=footway];
  relation["area:highway"=footway];
  node[highway=crossing];
  node[barrier=kerb];
  way[highway][!footway];
);
out geom;
